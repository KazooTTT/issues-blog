---
import { siteConfig } from "@/config";
import WritingFilter from "@/components/WritingFilter.astro";
import NavigationDropdown from "@/components/NavigationDropdown.astro";
import Analytics from "@/components/Analytics.astro";
import ContentEnhancements from "@/components/ContentEnhancements.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { sitePath } from "@/utils/presentation";
import "@/styles/global.css";
import "@/styles/prose.css";
import "@/styles/layout.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
}

const {
  title,
  description = siteConfig.description,
  canonical = Astro.url.pathname,
  type = "website",
} = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonicalUrl = new URL(sitePath(canonical), Astro.site);
const socialImage = new URL(sitePath("/social-card.svg"), Astro.site);
const pathname = Astro.url.pathname;
const routePath = (path: string) => sitePath(path);
const routeIs = (path: string) => pathname === routePath(path);
const routeStartsWith = (path: string) => pathname.startsWith(routePath(path));
const articleActive =
  routeStartsWith("/posts/") ||
  routeStartsWith("/tags/") ||
  routeStartsWith("/collections/") ||
  routeStartsWith("/archive/") ||
  routeStartsWith("/popular/");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f4ef" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={sitePath("/favicon.svg?v=terracotta-1")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={sitePath("/rss.xml")} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const key = "theme";
        const channel =
          "BroadcastChannel" in window
            ? new BroadcastChannel("blog-theme")
            : undefined;
        const validTheme = (value) => value === "light" || value === "dark";
        const read = () => {
          try {
            const stored = localStorage.getItem(key);
            if (validTheme(stored)) return stored;
          } catch {
            // Cookies keep the preference working when storage is unavailable.
          }
          const cookie = document.cookie
            .split("; ")
            .find((item) => item.startsWith(`${key}=`))
            ?.slice(key.length + 1);
          return validTheme(cookie) ? cookie : undefined;
        };
        const apply = (theme) => {
          if (validTheme(theme)) {
            document.documentElement.dataset.theme = theme;
          } else {
            delete document.documentElement.dataset.theme;
          }
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", theme === "dark" ? "#1c1b18" : "#f6f4ef");
        };
        const save = (theme) => {
          try {
            localStorage.setItem(key, theme);
          } catch {
            // The cookie below is the persistence fallback.
          }
          document.cookie = `theme=${theme}; Path=/; Max-Age=31536000; SameSite=Lax`;
          channel?.postMessage(theme);
        };

        window.blogTheme = { apply, read, save };
        channel?.addEventListener("message", (event) => apply(event.data));
        apply(read());
      })();
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F4KLD4XCDB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F4KLD4XCDB');
    </script>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="247d7726-70c1-46fd-9453-fbe95630c3d6"></script>
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "pohe09gc22");
    </script>
    <script is:inline>
      try {
        if (localStorage.getItem("human-writing-only") === "true") {
          document.documentElement.dataset.humanWritingOnly = "true";
        }
      } catch {}
    </script>
    <Analytics />
  </head>
  <body id="page-top">
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={sitePath("/")} aria-label={`${siteConfig.title} 首页`}>
          <span class="brand-mark" aria-hidden="true">K</span>
          <span>
            <strong>{siteConfig.title}</strong>
            <small>{siteConfig.tagline}</small>
          </span>
        </a>
        <nav aria-label="主导航">
          <NavigationDropdown label="文章" active={articleActive}>
            <a class:list={{ "nav-link-active": routeIs("/popular/") }} href={sitePath("/popular/")}>热门文章</a>
            <a class:list={{ "nav-link-active": routeIs("/archive/") }} href={sitePath("/archive/")}>归档</a>
            <div class="nav-topic-group" role="group" aria-labelledby="nav-topic-heading">
              <span class="nav-group-heading" id="nav-topic-heading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 5h16l-6 7v6l-4 2v-8z" />
                </svg>
                按主题阅读
              </span>
            {siteConfig.primaryTags.map((tag) => (
              <a class:list={{ "nav-link-active": routeIs(`/tags/${encodeURIComponent(tag)}/`) }} href={sitePath(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
            ))}
            {siteConfig.tagCollections.map((collection) => (
              <a class:list={{ "nav-link-active": routeIs(`/collections/${collection.slug}/`) }} href={sitePath(`/collections/${collection.slug}/`)}>{collection.label}</a>
            ))}
            </div>
            <a class:list={["nav-all-tags", { "nav-link-active": routeIs("/tags/") }]} href={sitePath("/tags/")}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 13l-7 7a2 2 0 0 1-3 0l-7-7V4h9l8 8a1 1 0 0 1 0 1z" />
                <circle cx="7.5" cy="8" r="1" />
              </svg>
              浏览全部标签
            </a>
          </NavigationDropdown>
          <NavigationDropdown label="探索" active={routeStartsWith("/projects/") || routeStartsWith("/tools/")}>
            <a class:list={{ "nav-link-active": routeStartsWith("/projects/") }} href={sitePath("/projects/")}>项目</a>
            <a class:list={{ "nav-link-active": routeStartsWith("/tools/") }} href={sitePath("/tools/")}>工具</a>
            <a href="https://daily.kazoottt.top/" target="_blank" rel="noopener noreferrer">每日收集 ↗</a>
          </NavigationDropdown>
          <NavigationDropdown label="生活" active={routeStartsWith("/workouts/") || routeStartsWith("/friends/")}>
            <a class:list={{ "nav-link-active": routeStartsWith("/workouts/") }} href={sitePath("/workouts/")}>运动</a>
            <a class:list={{ "nav-link-active": routeStartsWith("/friends/") }} href={sitePath("/friends/")}>友链</a>
          </NavigationDropdown>

          <a
            class:list={{ "nav-link-active": routeStartsWith("/about/") }}
            href={sitePath("/about/")}
          >关于</a>
          <WritingFilter />
          <button class="theme-toggle" type="button" aria-label="切换明暗主题" data-theme-toggle>
            <span aria-hidden="true">◐</span>
          </button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <p>© {new Date().getFullYear()} {siteConfig.title}</p>
          <p>
            <a
              class="site-source-link"
              href="https://github.com/KazooTTT/issues-blog"
              target="_blank"
              rel="noopener noreferrer"
            >文章由 GitHub Issues 提供内容 ↗</a>
          </p>
        </div>
        <SocialLinks compact />
      </footer>
    </div>
    <ContentEnhancements />
    <script is:inline>
      const header = document.querySelector(".site-header");
      const updateHeaderHeight = () => {
        if (header) document.documentElement.style.setProperty("--header-height", `${header.getBoundingClientRect().height}px`);
      };
      updateHeaderHeight();
      if (header && "ResizeObserver" in window) new ResizeObserver(updateHeaderHeight).observe(header);
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        window.blogTheme?.apply(next);
        window.blogTheme?.save(next);
      });
      window.addEventListener("pageshow", () => {
        window.blogTheme?.apply(window.blogTheme.read());
      });
      window.addEventListener("storage", (event) => {
        if (event.key === "theme") {
          window.blogTheme?.apply(event.newValue ?? window.blogTheme.read());
        }
      });
      const dropdowns = [...document.querySelectorAll("[data-header-dropdown]")];
      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener("toggle", () => {
          if (!dropdown.open) return;
          dropdowns.forEach((other) => {
            if (other !== dropdown) other.open = false;
          });
        });
        dropdown.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !dropdown.open) return;
          dropdown.open = false;
          dropdown.querySelector("summary")?.focus();
          event.stopPropagation();
        });
        dropdown.addEventListener("focusout", () => {
          setTimeout(() => {
            if (!dropdown.contains(document.activeElement)) dropdown.open = false;
          }, 0);
        });
      });
      document.addEventListener("click", (event) => {
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(event.target)) dropdown.open = false;
        });
      });
    </script>
  </body>
</html>
