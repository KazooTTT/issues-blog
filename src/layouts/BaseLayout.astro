---
import { siteConfig } from "@/config";
import Analytics from "@/components/Analytics.astro";
import ContentEnhancements from "@/components/ContentEnhancements.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { sitePath } from "@/utils/presentation";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
}

const {
  title,
  description = siteConfig.description,
  canonical = Astro.url.pathname,
  type = "website",
} = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonicalUrl = new URL(sitePath(canonical), Astro.site);
const socialImage = new URL(sitePath("/social-card.svg"), Astro.site);
const pathname = Astro.url.pathname;
const routePath = (path: string) => sitePath(path);
const routeIs = (path: string) => pathname === routePath(path);
const routeStartsWith = (path: string) => pathname.startsWith(routePath(path));
const articleActive =
  routeStartsWith("/posts/") ||
  routeStartsWith("/tags/") ||
  routeStartsWith("/archive/");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3eee4" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={sitePath("/rss.xml")} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <Analytics />
    <script is:inline>
      (() => {
        const key = "theme";
        const channel =
          "BroadcastChannel" in window
            ? new BroadcastChannel("blog-theme")
            : undefined;
        const validTheme = (value) => value === "light" || value === "dark";
        const read = () => {
          try {
            const stored = localStorage.getItem(key);
            if (validTheme(stored)) return stored;
          } catch {
            // Cookies keep the preference working when storage is unavailable.
          }
          const cookie = document.cookie
            .split("; ")
            .find((item) => item.startsWith(`${key}=`))
            ?.slice(key.length + 1);
          return validTheme(cookie) ? cookie : undefined;
        };
        const apply = (theme) => {
          if (validTheme(theme)) {
            document.documentElement.dataset.theme = theme;
          } else {
            delete document.documentElement.dataset.theme;
          }
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", theme === "dark" ? "#191917" : "#f3eee4");
        };
        const save = (theme) => {
          try {
            localStorage.setItem(key, theme);
          } catch {
            // The cookie below is the persistence fallback.
          }
          document.cookie = `theme=${theme}; Path=/; Max-Age=31536000; SameSite=Lax`;
          channel?.postMessage(theme);
        };

        window.blogTheme = { apply, read, save };
        channel?.addEventListener("message", (event) => apply(event.data));
        apply(read());
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={sitePath("/")} aria-label={`${siteConfig.title} 首页`}>
          <span class="brand-mark" aria-hidden="true">K</span>
          <span>
            <strong>{siteConfig.title}</strong>
            <small>{siteConfig.tagline}</small>
          </span>
        </a>
        <nav aria-label="主导航">
          <div class="nav-menu" data-nav-menu>
            <a
              class:list={["nav-menu-primary", { "nav-link-active": articleActive }]}
              href={sitePath("/archive/")}
              aria-current={articleActive ? "page" : undefined}
            >文章</a>
            <button
              class="nav-menu-toggle"
              type="button"
              aria-label="展开文章菜单"
              aria-expanded="false"
              data-nav-menu-toggle
            ></button>
            <div class="nav-dropdown">
              <a
                class:list={{ "nav-link-active": routeStartsWith("/archive/") }}
                href={sitePath("/archive/")}
              >归档</a>
              {siteConfig.primaryTags.map((tag) => (
                <a
                  class:list={{ "nav-link-active": routeIs(`/tags/${encodeURIComponent(tag)}/`) }}
                  href={sitePath(`/tags/${encodeURIComponent(tag)}/`)}
                >{tag}</a>
              ))}
              <a
                class:list={{ "nav-link-active": routeIs("/tags/") }}
                href={sitePath("/tags/")}
              >标签</a>
            </div>
          </div>
          <a
            class:list={{ "nav-link-active": routeStartsWith("/tools/") }}
            href={sitePath("/tools/")}
          >工具</a>
          <a
            class:list={["extras-nav-link", { "nav-link-active": routeStartsWith("/workouts/") }]}
            href={sitePath("/workouts/")}
          >运动</a>
          <a
            class:list={["extras-nav-link", { "nav-link-active": routeStartsWith("/friends/") }]}
            href={sitePath("/friends/")}
          >友链</a>
          <a
            class:list={{ "nav-link-active": routeStartsWith("/about/") }}
            href={sitePath("/about/")}
          >关于</a>
          <button class="theme-toggle" type="button" aria-label="切换明暗主题" data-theme-toggle>
            <span aria-hidden="true">◐</span>
          </button>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <p>© {new Date().getFullYear()} {siteConfig.title}</p>
          <p>
            <a
              class="site-source-link"
              href="https://github.com/KazooTTT/issues-blog"
              target="_blank"
              rel="noopener noreferrer"
            >文章由 GitHub Issues 提供内容 ↗</a>
          </p>
        </div>
        <SocialLinks compact />
      </footer>
    </div>
    <ContentEnhancements />
    <script is:inline>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        window.blogTheme?.apply(next);
        window.blogTheme?.save(next);
      });
      window.addEventListener("pageshow", () => {
        window.blogTheme?.apply(window.blogTheme.read());
      });
      window.addEventListener("storage", (event) => {
        if (event.key === "theme") {
          window.blogTheme?.apply(event.newValue ?? window.blogTheme.read());
        }
      });
      const navMenu = document.querySelector("[data-nav-menu]");
      const navMenuToggle = document.querySelector("[data-nav-menu-toggle]");
      navMenuToggle?.addEventListener("click", () => {
        const open = navMenu?.classList.toggle("is-open") ?? false;
        navMenuToggle.setAttribute("aria-expanded", String(open));
      });
      document.addEventListener("click", (event) => {
        if (navMenu?.contains(event.target)) return;
        navMenu?.classList.remove("is-open");
        navMenuToggle?.setAttribute("aria-expanded", "false");
      });
    </script>
  </body>
</html>
