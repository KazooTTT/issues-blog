---
import { getSiteContent } from "@/data/site-content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { renderMarkdown } from "@/rendering/content";

const { about } = await getSiteContent();
const html = about ? await renderMarkdown(about.body) : "";
---

<BaseLayout title="关于">
  <section class="page-intro about-intro">
    <span class="eyebrow">ABOUT</span>
    <h1>{about?.title ?? "关于"}</h1>
  </section>
  {about ? <div class="prose about-body" set:html={html} /> : (
    <p class="empty-state">还没有设置带有 blog:about 标签的 Issue。</p>
  )}
</BaseLayout>
