---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { safeGithubUrl } from "@/wishlist/types";
const endpoint = import.meta.env.PUBLIC_WISHLIST_API_URL ?? "";
const projectUrl = safeGithubUrl(
  import.meta.env.PUBLIC_WISHLIST_PROJECT_URL ?? "",
);
---

<BaseLayout
  title="愿望清单"
  description="记录想买的东西、想做的事情，以及一点点实现的愿望。"
>
  <section class="page-intro wishlist-intro">
    <span class="eyebrow">A LITTLE AT A TIME</span>
    <h1>愿望清单</h1>
    <p>有些是想拥有的东西，有些是想经历的生活。先记下来，再一点点实现。</p>
  </section>
  <section
    class="wishlist"
    data-wishlist
    data-endpoint={endpoint}
    data-project-url={projectUrl}
  >
    <div class="wish-summary" aria-label="愿望进度">
      <div>
        <strong data-total>—</strong>
        <span>个愿望</span>
      </div>
      <div>
        <strong data-pending>—</strong>
        <span>等待实现</span>
      </div>
      <div>
        <strong data-done>—</strong>
        <span>已经实现</span>
      </div>
      <div class="wish-progress">
        <label for="wish-progress">
          慢慢来，也在向前 <span data-percent>—</span>
        </label>
        <progress id="wish-progress" max="100" value="0"></progress>
      </div>
    </div>
    <div class="wish-toolbar">
      <div class="wish-kinds" role="group" aria-label="愿望类型">
        <button type="button" data-kind="all" aria-pressed="true">
          全部
        </button>
        <button type="button" data-kind="buy" aria-pressed="false">
          想买
        </button>
        <button type="button" data-kind="do" aria-pressed="false">
          想做
        </button>
        <button type="button" data-kind="other" aria-pressed="false">
          其他
        </button>
      </div>
      <div class="wish-search">
        <label>
          <span class="sr-only">搜索愿望</span>
          <input type="search" placeholder="搜索愿望…" data-search />
        </label>
        <label>
          <span class="sr-only">筛选状态</span>
          <select data-status>
            <option value="all">所有状态</option>
            <option value="todo">待实现</option>
            <option value="doing">进行中</option>
            <option value="done">已实现</option>
          </select>
        </label>
      </div>
    </div>
    <div class="wish-sync">
      <p role="status" aria-live="polite" data-sync>
        正在加载愿望清单…
      </p>
      <button type="button" data-refresh>
        刷新
      </button>
      <a
        data-project
        href={projectUrl || undefined}
        hidden={!projectUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        在 GitHub 编辑 ↗
      </a>
    </div>
    <div class="wish-list" data-list aria-busy="true"></div>
    <p class="wish-empty" data-empty hidden>
      还没有愿望，给未来留一点期待。
    </p>
    <noscript>
      <p>
        启用 JavaScript 后可查看最新愿望清单。
        {projectUrl && <a href={projectUrl}>也可以前往 GitHub 看板。</a>}
      </p>
    </noscript>
  </section>
</BaseLayout>
<script>
  import {
    isWishlistData,
    safeGithubUrl,
    type Wish,
    type WishlistData,
    type WishKind,
  } from "@/wishlist/types";
  const root = document.querySelector<HTMLElement>("[data-wishlist]")!;
  const find = <T extends HTMLElement>(selector: string) =>
    root.querySelector<T>(selector)!;
  const list = find<HTMLDivElement>("[data-list]");
  const sync = find<HTMLParagraphElement>("[data-sync]");
  const empty = find<HTMLParagraphElement>("[data-empty]");
  const refresh = find<HTMLButtonElement>("[data-refresh]");
  let data: WishlistData | undefined;
  let kind: WishKind | "all" = "all";
  let loading = false;
  const statusNames = { todo: "待实现", doing: "进行中", done: "已实现" };
  const kindNames = { buy: "想买", do: "想做", other: "其他" };
  function node<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    text: string,
    className = "",
  ) {
    const element = document.createElement(tag);
    element.textContent = text;
    element.className = className;
    return element;
  }
  function card(wish: Wish) {
    const article = node("article", "", `wish-card wish-${wish.status}`);
    const heading = node("div", "", "wish-card-heading");
    heading.append(
      node(
        "span",
        wish.status === "done" ? "✓" : wish.status === "doing" ? "↗" : "○",
        "wish-symbol",
      ),
      node("span", statusNames[wish.status], "wish-state"),
    );
    const title = node("h2", wish.title);
    article.append(heading, title);
    if (wish.description)
      article.append(node("p", wish.description, "wish-description"));
    const tags = node("div", "", "wish-tags");
    for (const text of [kindNames[wish.kind], wish.category, wish.priority])
      if (text) tags.append(node("span", text));
    article.append(tags);
    const meta = node("div", "", "wish-meta");
    if (wish.budget) meta.append(node("span", `预算 ${wish.budget}`));
    if (wish.targetDate) meta.append(node("span", `目标 ${wish.targetDate}`));
    const url = safeGithubUrl(wish.url);
    if (url) {
      const link = node("a", "查看详情 ↗");
      link.href = url;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      meta.append(link);
    }
    if (meta.childNodes.length) article.append(meta);
    return article;
  }
  function render() {
    if (!data) return;
    const search = find<HTMLInputElement>("[data-search]")
      .value.trim()
      .toLocaleLowerCase();
    const status = find<HTMLSelectElement>("[data-status]").value;
    const visible = data.items.filter(
      (wish) =>
        (kind === "all" || wish.kind === kind) &&
        (status === "all" || wish.status === status) &&
        [wish.title, wish.description, wish.category]
          .join(" ")
          .toLocaleLowerCase()
          .includes(search),
    );
    list.replaceChildren(...visible.map(card));
    const done = data.items.filter((wish) => wish.status === "done").length;
    const percent = data.items.length
      ? Math.round((done / data.items.length) * 100)
      : 0;
    find("[data-total]").textContent = String(data.items.length);
    find("[data-pending]").textContent = String(data.items.length - done);
    find("[data-done]").textContent = String(done);
    find("[data-percent]").textContent = `${percent}%`;
    find<HTMLProgressElement>("#wish-progress").value = percent;
    empty.hidden = visible.length > 0;
    empty.textContent = data.items.length
      ? "没有匹配的愿望，试试其他筛选条件。"
      : "还没有愿望，给未来留一点期待。";
  }
  async function update() {
    if (loading) return;
    const endpoint = root.dataset.endpoint;
    if (!endpoint) {
      sync.textContent = "愿望清单正在准备中。";
      refresh.hidden = true;
      list.setAttribute("aria-busy", "false");
      return;
    }
    loading = true;
    refresh.disabled = true;
    list.setAttribute("aria-busy", "true");
    if (!data) sync.textContent = "正在加载愿望清单…";
    try {
      const url = new URL(endpoint);
      if (
        url.protocol !== "https:" &&
        !(import.meta.env.DEV && url.hostname === "localhost")
      )
        throw new Error("endpoint");
      const response = await fetch(url, {
        cache: "no-store",
        credentials: "omit",
        signal: AbortSignal.timeout(15_000),
      });
      if (!response.ok) throw new Error("unavailable");
      const result: unknown = await response.json();
      if (!isWishlistData(result)) throw new Error("invalid_data");
      data = result;
      render();
      const project = find<HTMLAnchorElement>("[data-project]");
      project.href = safeGithubUrl(data.projectUrl);
      project.hidden = false;
      sync.textContent = `最近同步 ${new Date(data.fetchedAt).toLocaleString("zh-CN", { month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit" })} · 每分钟自动更新`;
    } catch {
      sync.textContent = data
        ? "暂时无法同步，当前显示上次读取的内容。可稍后刷新或查看 GitHub 看板。"
        : "暂时无法加载愿望清单，请稍后刷新或查看 GitHub 看板。";
    } finally {
      loading = false;
      refresh.disabled = false;
      list.setAttribute("aria-busy", "false");
    }
  }
  root.querySelectorAll<HTMLButtonElement>("[data-kind]").forEach((button) =>
    button.addEventListener("click", () => {
      kind = button.dataset.kind as typeof kind;
      root
        .querySelectorAll("[data-kind]")
        .forEach((other) =>
          other.setAttribute("aria-pressed", String(other === button)),
        );
      render();
    }),
  );
  find<HTMLInputElement>("[data-search]").addEventListener("input", render);
  find<HTMLSelectElement>("[data-status]").addEventListener("change", render);
  refresh.addEventListener("click", update);
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) void update();
  });
  window.setInterval(() => {
    if (!document.hidden) void update();
  }, 60_000);
  void update();
</script>
<style is:global>
  .wishlist {
    padding-bottom: 72px;
  }
  .wishlist-intro {
    max-width: 700px;
  }
  .wish-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr) 2fr;
    gap: 24px;
    padding: 28px 0;
    border-block: 1px solid var(--line);
  }
  .wish-summary strong {
    display: block;
    font-size: 34px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .wish-summary span {
    color: var(--muted);
    font-size: 13px;
  }
  .wish-progress {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .wish-progress label {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
  }
  .wishlist progress {
    width: 100%;
    height: 7px;
    border: 0;
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper-deep);
    accent-color: var(--accent);
  }
  .wishlist progress::-webkit-progress-bar {
    background: var(--paper-deep);
  }
  .wishlist progress::-webkit-progress-value {
    background: var(--accent);
  }
  .wish-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .wish-kinds,
  .wish-search {
    display: flex;
    gap: 8px;
  }
  .wishlist button,
  .wishlist input,
  .wishlist select {
    color: var(--ink);
    font: inherit;
    font-size: 14px;
  }
  .wish-kinds button {
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: 24px;
    padding: 10px 18px;
    cursor: pointer;
  }
  .wish-kinds button[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .wishlist input,
  .wishlist select {
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: 6px;
    padding: 10px 12px;
    min-height: 42px;
  }
  .wishlist input {
    width: 210px;
  }
  .wish-sync {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-block: 16px 24px;
    color: var(--muted);
    font-size: 12px;
  }
  .wish-sync p {
    flex: 1;
    margin: 0;
  }
  .wish-sync button {
    background: none;
    border: 0;
    padding: 10px 0;
    color: var(--accent-dark);
    font-size: 12px;
    cursor: pointer;
  }
  .wishlist button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .wish-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .wish-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    overflow-wrap: anywhere;
  }
  .wish-card-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .wish-symbol {
    color: var(--accent);
    font-size: 24px;
  }
  .wish-state {
    color: var(--muted);
    font-size: 12px;
  }
  .wish-card h2 {
    font-size: 18px;
    line-height: 1.6;
    margin: 18px 0;
    font-weight: 500;
  }
  .wish-done h2 {
    color: var(--muted);
  }
  .wish-description {
    white-space: pre-wrap;
    line-height: 1.8;
    color: var(--muted);
    font-size: 13px;
    margin: 0 0 18px;
  }
  .wish-tags {
    margin-top: auto;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .wish-tags span {
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    color: var(--muted);
    background: var(--paper-deep);
  }
  .wish-meta {
    border-top: 1px solid var(--line);
    margin-top: 18px;
    padding-top: 14px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--muted);
  }
  .wish-meta a {
    margin-left: auto;
  }
  .wish-empty {
    text-align: center;
    padding: 64px 20px;
    color: var(--muted);
    border: 1px dashed var(--line);
    border-radius: 10px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .wishlist [hidden] {
    display: none !important;
  }
  @media (max-width: 900px) {
    .wish-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .wish-summary {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    .wish-summary strong {
      font-size: 28px;
    }
    .wish-progress {
      grid-column: 1 / -1;
    }
    .wish-list {
      grid-template-columns: 1fr;
    }
    .wish-toolbar,
    .wish-search {
      align-items: stretch;
    }
    .wish-search {
      width: 100%;
    }
    .wish-search label:first-child {
      flex: 1;
      min-width: 0;
    }
    .wishlist input {
      width: 100%;
      box-sizing: border-box;
    }
    .wish-kinds button {
      padding: 10px 15px;
    }
    .wish-sync p {
      flex-basis: 100%;
    }
  }
</style>
