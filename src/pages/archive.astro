---
import { getSiteContent } from "@/data/site-content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { archiveDateParts, sitePath } from "@/utils/presentation";

const { posts } = await getSiteContent();
// 「新增博文 / 新增草稿」分别对应两个 issue 模板，标签由模板 frontmatter 声明：
// - article.md：自动携带 blog:publish，创建即发布
// - article-draft.md：不带发布标签，写完后手动加 blog:publish 发布
// （GitHub 的 URL labels 参数不可靠，统一走模板 frontmatter 机制。）
const newPostUrl = new URL("https://github.com/KazooTTT/issues-blog/issues/new");
newPostUrl.searchParams.set("template", "article.md");
const newDraftUrl = new URL("https://github.com/KazooTTT/issues-blog/issues/new");
newDraftUrl.searchParams.set("template", "article-draft.md");
const datedPosts = posts.map((post) => ({
  post,
  date: archiveDateParts(post.publishedAt),
}));
const postsByYear = Object.groupBy(datedPosts, ({ date }) => date.year);
const archive = Object.keys(postsByYear)
  .sort()
  .reverse()
  .map((year) => {
    const postsByMonth = Object.groupBy(
      postsByYear[year] ?? [],
      ({ date }) => date.month,
    );

    return {
      year,
      months: Object.keys(postsByMonth)
        .sort()
        .reverse()
        .map((month) => ({ month, posts: postsByMonth[month] ?? [] })),
    };
  });
---

<BaseLayout title="归档">
  <section class="page-intro">
    <span class="eyebrow">ARCHIVE · {posts.length} POSTS</span>
    <h1>文章归档</h1>
    <p>按首次发布时间，回看不同时期留下的记录。</p>
    <div class="new-post-menu">
      <button class="button new-post-menu-button" type="button">
        新增博文 ▾
      </button>
      <div class="new-post-dropdown">
        <a href={newPostUrl} target="_blank" rel="noopener noreferrer">
          <strong>新增博文 ↗</strong>
          <span>自动携带 blog:publish 标签，创建即发布</span>
        </a>
        <a href={newDraftUrl} target="_blank" rel="noopener noreferrer">
          <strong>新增草稿 ↗</strong>
          <span>不带发布标签，写完后再手动添加 blog:publish 发布</span>
        </a>
      </div>
    </div>
  </section>
  <div class="archive">
    {archive.map(({ year, months }) => (
      <section class="archive-year">
        <h2>{year}</h2>
        <div class="archive-months">
          {months.map(({ month, posts: monthPosts }) => (
            <div class="archive-month">
              <h3>{month}月</h3>
              <ol>
                {monthPosts.map(({ post, date }) => (
                  <li>
                    <time datetime={post.publishedAt}>{date.day}日</time>
                    <a href={sitePath(post.permalink)}>{post.title}</a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
