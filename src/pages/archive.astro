---
import { getSiteContent } from "@/data/site-content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { archiveDateParts, sitePath } from "@/utils/presentation";

const { posts } = await getSiteContent();
const datedPosts = posts.map((post) => ({
  post,
  date: archiveDateParts(post.publishedAt),
}));
const postsByYear = Object.groupBy(datedPosts, ({ date }) => date.year);
const archive = Object.keys(postsByYear)
  .sort()
  .reverse()
  .map((year) => {
    const postsByMonth = Object.groupBy(
      postsByYear[year] ?? [],
      ({ date }) => date.month,
    );

    return {
      year,
      months: Object.keys(postsByMonth)
        .sort()
        .reverse()
        .map((month) => ({ month, posts: postsByMonth[month] ?? [] })),
    };
  });
---

<BaseLayout title="归档">
  <section class="page-intro">
    <span class="eyebrow">ARCHIVE · {posts.length} POSTS</span>
    <h1>文章归档</h1>
    <p>按首次发布时间，回看不同时期留下的记录。</p>
  </section>
  <div class="archive">
    {archive.map(({ year, months }) => (
      <section class="archive-year">
        <h2>{year}</h2>
        <div class="archive-months">
          {months.map(({ month, posts: monthPosts }) => (
            <div class="archive-month">
              <h3>{month}月</h3>
              <ol>
                {monthPosts.map(({ post, date }) => {
                  const visibleTags = post.tags.slice(0, 3);
                  const hiddenTagCount = post.tags.length - visibleTags.length;

                  return (
                    <li>
                      <time datetime={post.publishedAt}>{date.day}日</time>
                      <a href={sitePath(post.permalink)}>{post.title}</a>
                      <span class="archive-tags">
                        {visibleTags.map((tag) => (
                          <a
                            class="archive-tag"
                            href={sitePath(`/tags/${encodeURIComponent(tag)}/`)}
                            title={tag}
                          >
                            {tag}
                          </a>
                        ))}
                        {hiddenTagCount > 0 && (
                          <span
                            class="archive-tag-overflow"
                            aria-label={`另有 ${hiddenTagCount} 个标签`}
                          >
                            +{hiddenTagCount}
                          </span>
                        )}
                      </span>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
