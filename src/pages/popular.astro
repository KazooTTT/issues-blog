---
import PostList from "@/components/PostList.astro";
import { getPageAnalytics } from "@/data/page-analytics";
import { getSiteContent } from "@/data/site-content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { popularPosts } from "@/utils/popular-posts";
import { sitePath } from "@/utils/presentation";

const [{ posts }, analytics] = await Promise.all([getSiteContent(), getPageAnalytics()]);
const rankedPosts = analytics ? popularPosts(posts, analytics) : [];
---

<BaseLayout title="热门文章" description="按近 30 天浏览量排序，看看最近大家在读什么。">
  <section class="page-intro">
    <span class="eyebrow">POPULAR · LAST 30 DAYS</span>
    <h1>热门文章</h1>
    <p>最近大家在读什么：按近 30 天浏览量排序，展示前 20 篇。</p>
    {analytics && <p class="popular-period">统计截至 {analytics.throughDate} · 每日更新</p>}
  </section>
  {rankedPosts.length > 0 ? (
    <PostList posts={rankedPosts} ranked />
  ) : (
    <div class="popular-empty">
      <p>{analytics ? "近 30 天暂时没有文章访问记录。" : "访问统计暂时不可用，热门榜单稍后更新。"}</p>
      <a href={sitePath("/archive/")}>先看看全部文章 →</a>
    </div>
  )}
</BaseLayout>

<style>
  .popular-period { color: var(--muted); font-size: 13px; }
  .popular-empty { padding: 32px 0 64px; color: var(--muted); }
  .popular-empty a { display: inline-block; margin-top: 12px; color: var(--accent-dark); }
</style>
