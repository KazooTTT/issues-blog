---
import { friendLinks } from "@/data/friends";
import BaseLayout from "@/layouts/BaseLayout.astro";

const links = friendLinks.map((friend) => ({
  ...friend,
  displayUrl: friend.url.replace(/^https?:\/\//, "").replace(/\/$/, ""),
}));
---

<BaseLayout title="友链" description="我经常访问的博客和个人网站">
  <section class="page-intro extras-intro">
    <span class="eyebrow">FRIENDS / 友情链接</span>
    <h1>友链</h1>
    <p>一些我经常访问的博客和个人网站。互联网很大，这里留几扇通往朋友们的小门。</p>
  </section>

  <section class="link-grid" aria-label="友链列表">
    {links.map((friend, index) => (
      <a class="link-card" href={friend.url} target="_blank" rel="noopener noreferrer">
        <span class="link-index">{String(index + 1).padStart(2, "0")}</span>
        <strong>{friend.name}</strong>
        <small>{friend.displayUrl}</small>
        <span class="link-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </section>

  <p class="extras-note">目前共 {links.length} 个站点，也欢迎交换友链。</p>
</BaseLayout>
