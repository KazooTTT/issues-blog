---
export const prerender = false;

import WorkoutDetails from "@/components/WorkoutDetails.astro";
import BackToTop from "@/components/BackToTop.astro";
import { getSiteContent } from "@/data/site-content";
import { loadRuntimeDb, loadWorkoutPage } from "@/data/workout-store";
import { indexWorkoutReviews } from "@/domain/workout-reviews";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { renderMarkdown } from "@/rendering/content";
import { formatDate } from "@/utils/presentation";

// 单条运动按需渲染，数据来自 D1。
const page = await loadWorkoutPage(Astro.params.id ?? "", await loadRuntimeDb());
if (!page) {
  return new Response("运动记录不存在", {
    status: 404,
    headers: { "content-type": "text/plain; charset=utf-8" },
  });
}

const { workout, previousWorkout, nextWorkout } = page;
const { workoutReviews } = await getSiteContent();
// 详情页只关心当前这条运动的复盘，其他运动的状态（可能已从 D1 中消失）
// 不应该让本页 500。
const review = indexWorkoutReviews(
  workoutReviews.filter((item) => item.workoutId === workout.externalId),
  [workout.externalId],
).get(workout.externalId);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const reviewIssueUrl = new URL("https://github.com/KazooTTT/issues-blog/issues/new");
reviewIssueUrl.searchParams.set("template", "workout-review.md");
reviewIssueUrl.searchParams.set("title", `运动复盘｜${workout.activityDate}｜${workout.name}`);
reviewIssueUrl.searchParams.set("labels", "workout:review");
reviewIssueUrl.searchParams.set(
  "body",
  [
    "<!-- workout-review:v1 -->",
    `<!-- workout-id: ${workout.externalId} -->`,
    "",
    "## 这次完成得怎么样",
    "",
    "",
    "## 做得好的地方",
    "",
    "",
    "## 下次调整",
    "",
    "",
  ].join("\n"),
);
const reviewActionUrl = review?.url ?? reviewIssueUrl;
const reviewHtml = review ? await renderMarkdown(review.body) : undefined;
---

<BaseLayout title={`${workout.name} · 运动详情`} description={`${workout.activityDate} ${workout.name}的完整训练详情`}>
  <article class="workout-detail-page">
    <a class="workout-detail-back" href={`${basePath}/workouts/`}>← 返回运动记录</a>
    <header>
      <span class="eyebrow">WORKOUT / 运动详情</span>
      <h1>{workout.name}</h1>
      <p>{workout.activityDate} · Garmin #{workout.externalId}</p>
      <a
        class="button workout-review-button"
        href={reviewActionUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {review ? "编辑复盘 ↗" : "新增复盘 ↗"}
      </a>
    </header>
    <div class="workout-detail-content">
      {review && reviewHtml && (
        <section class="workout-review" aria-labelledby="workout-review-title">
          <header>
            <div>
              <span class="eyebrow">REFLECTION / 复盘</span>
              <h2 id="workout-review-title">复盘笔记</h2>
            </div>
            <p>
              Issue #{review.number} · 更新于 {formatDate(review.updatedAt)}
            </p>
          </header>
          <div class="prose workout-review-body" set:html={reviewHtml} />
        </section>
      )}
      <WorkoutDetails workout={workout} />
      <nav class="workout-detail-navigation" aria-label="相邻运动">
        {previousWorkout ? (
          <a href={`${basePath}/workouts/${previousWorkout.externalId}/`} rel="prev">
            <span>← 上一个运动</span>
            <strong>{previousWorkout.name}</strong>
            <small>{previousWorkout.activityDate}</small>
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}
        {nextWorkout && (
          <a href={`${basePath}/workouts/${nextWorkout.externalId}/`} rel="next">
            <span>下一个运动 →</span>
            <strong>{nextWorkout.name}</strong>
            <small>{nextWorkout.activityDate}</small>
          </a>
        )}
      </nav>
    </div>
  </article>
  <BackToTop />
</BaseLayout>
