---
import { workouts, type Workout } from "@/data/workouts";
import BaseLayout from "@/layouts/BaseLayout.astro";

type WorkoutKind =
  | "strength"
  | "dance"
  | "cardio"
  | "hiit"
  | "run"
  | "walk"
  | "other";

const workoutKinds: Record<
  WorkoutKind,
  { label: string; mark: string }
> = {
  strength: { label: "力量", mark: "力" },
  dance: { label: "舞蹈", mark: "舞" },
  cardio: { label: "有氧", mark: "氧" },
  hiit: { label: "HIIT", mark: "H" },
  run: { label: "跑步", mark: "跑" },
  walk: { label: "步行", mark: "步" },
  other: { label: "其他", mark: "动" },
};
const trainingDetailSectionNames: Record<string, string> = {
  heartRateZones: "心率区间",
  powerZones: "功率区间",
  splits: "分段",
  typedSplits: "类型化分段",
  splitSummaries: "分段汇总",
  exerciseSets: "力量动作组",
  _sync: "同步状态",
};

function workoutKind(name: string): WorkoutKind {
  const normalized = name.toLowerCase();
  if (normalized.includes("力量") || normalized.includes("strength")) return "strength";
  if (
    normalized.includes("舞") ||
    normalized.includes("dance") ||
    normalized.includes("dancing")
  ) return "dance";
  if (normalized.includes("hiit")) return "hiit";
  if (normalized.includes("跑") || normalized.includes("treadmill")) return "run";
  if (normalized.includes("步行") || normalized.includes("walk")) return "walk";
  if (normalized.includes("有氧") || normalized.includes("cardio")) return "cardio";
  return "other";
}

function formatDuration(totalSeconds: number): string {
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;
  return hours > 0
    ? `${hours}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`
    : `${minutes}:${String(seconds).padStart(2, "0")}`;
}

function formatDate(value: string): string {
  return new Intl.DateTimeFormat("zh-CN", {
    month: "2-digit",
    day: "2-digit",
    timeZone: "Asia/Shanghai",
  }).format(new Date(`${value}T12:00:00+08:00`));
}

function formatNumber(value: number, maximumFractionDigits = 1): string {
  return value.toLocaleString("zh-CN", { maximumFractionDigits });
}

function workoutDetails(workout: Workout): Array<[string, string]> {
  const details: Array<[string, string | undefined]> = [
    ["日期", workout.activityDate],
    ["本地开始", workout.startTimeLocal],
    ["GMT 开始", workout.startTimeGmt],
    ["Garmin 类型", workout.activityType],
    ["总时长", formatDuration(workout.durationSeconds)],
    [
      "移动时长",
      workout.movingDurationSeconds === undefined
        ? undefined
        : formatDuration(Math.round(workout.movingDurationSeconds)),
    ],
    [
      "经过时长",
      workout.elapsedDurationSeconds === undefined
        ? undefined
        : formatDuration(Math.round(workout.elapsedDurationSeconds)),
    ],
    ["活动热量", `${formatNumber(workout.caloriesKcal, 0)} kcal`],
    [
      "基础代谢热量",
      workout.bmrCaloriesKcal === undefined
        ? undefined
        : `${formatNumber(workout.bmrCaloriesKcal)} kcal`,
    ],
    [
      "平均心率",
      workout.averageHeartRateBpm === undefined
        ? undefined
        : `${formatNumber(workout.averageHeartRateBpm)} bpm`,
    ],
    [
      "最高心率",
      workout.maxHeartRateBpm === undefined
        ? undefined
        : `${formatNumber(workout.maxHeartRateBpm)} bpm`,
    ],
    [
      "距离",
      workout.distanceMeters === undefined
        ? undefined
        : workout.distanceMeters >= 1000
          ? `${formatNumber(workout.distanceMeters / 1000, 2)} km`
          : `${formatNumber(workout.distanceMeters)} m`,
    ],
    [
      "累计爬升",
      workout.elevationGainMeters === undefined
        ? undefined
        : `${formatNumber(workout.elevationGainMeters)} m`,
    ],
    [
      "累计下降",
      workout.elevationLossMeters === undefined
        ? undefined
        : `${formatNumber(workout.elevationLossMeters)} m`,
    ],
    [
      "平均速度",
      workout.averageSpeedMps === undefined
        ? undefined
        : `${formatNumber(workout.averageSpeedMps * 3.6)} km/h`,
    ],
    [
      "最高速度",
      workout.maxSpeedMps === undefined
        ? undefined
        : `${formatNumber(workout.maxSpeedMps * 3.6)} km/h`,
    ],
    [
      "平均功率",
      workout.averagePowerWatts === undefined
        ? undefined
        : `${formatNumber(workout.averagePowerWatts)} W`,
    ],
    [
      "最高功率",
      workout.maxPowerWatts === undefined
        ? undefined
        : `${formatNumber(workout.maxPowerWatts)} W`,
    ],
    [
      "标准化功率",
      workout.normalizedPowerWatts === undefined
        ? undefined
        : `${formatNumber(workout.normalizedPowerWatts)} W`,
    ],
    [
      "有氧训练效果",
      workout.aerobicTrainingEffect === undefined
        ? undefined
        : formatNumber(workout.aerobicTrainingEffect),
    ],
    [
      "无氧训练效果",
      workout.anaerobicTrainingEffect === undefined
        ? undefined
        : formatNumber(workout.anaerobicTrainingEffect),
    ],
    [
      "训练负荷",
      workout.trainingLoad === undefined
        ? undefined
        : formatNumber(workout.trainingLoad),
    ],
    ["训练效果", workout.trainingEffectLabel],
    [
      "平均步频",
      workout.averageRunningCadenceSpm === undefined
        ? undefined
        : `${formatNumber(workout.averageRunningCadenceSpm)} 步/分`,
    ],
    [
      "最高步频",
      workout.maxRunningCadenceSpm === undefined
        ? undefined
        : `${formatNumber(workout.maxRunningCadenceSpm)} 步/分`,
    ],
    [
      "总组数",
      workout.totalSets === undefined
        ? undefined
        : formatNumber(workout.totalSets, 0),
    ],
    [
      "有效组数",
      workout.activeSets === undefined
        ? undefined
        : formatNumber(workout.activeSets, 0),
    ],
    [
      "总次数",
      workout.totalReps === undefined
        ? undefined
        : formatNumber(workout.totalReps, 0),
    ],
    [
      "总容量",
      workout.totalVolume === undefined
        ? undefined
        : formatNumber(workout.totalVolume),
    ],
    ["Garmin ID", workout.externalId],
  ];

  return details.filter((detail): detail is [string, string] => detail[1] !== undefined);
}

function detailLabel(value: string): string {
  return value
    .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
    .replaceAll("_", " ")
    .replace(/^\w/, (letter) => letter.toUpperCase());
}

function flattenTrainingDetails(
  value: unknown,
  path: string[] = [],
): Array<[string, string]> {
  if (value === null || value === undefined) return [];
  if (typeof value !== "object") {
    return [[path.map(detailLabel).join(" · "), String(value)]];
  }
  if (Array.isArray(value)) {
    return value.flatMap((item, index) =>
      flattenTrainingDetails(item, [...path, `#${index + 1}`]),
    );
  }
  return Object.entries(value).flatMap(([key, item]) =>
    flattenTrainingDetails(item, [...path, key]),
  );
}

const latestDate = workouts[0]?.activityDate;
const latestTimestamp = latestDate
  ? new Date(`${latestDate}T12:00:00+08:00`).getTime()
  : 0;
const weekStart = latestTimestamp - 6 * 24 * 60 * 60 * 1000;
const recentWorkouts = workouts.filter((workout) => {
  const timestamp = new Date(`${workout.activityDate}T12:00:00+08:00`).getTime();
  return timestamp >= weekStart && timestamp <= latestTimestamp;
});
const recentMinutes = Math.round(
  recentWorkouts.reduce(
    (total, workout) => total + workout.durationSeconds,
    0,
  ) / 60,
);
const recentCalories = recentWorkouts.reduce(
  (total, workout) => total + workout.caloriesKcal,
  0,
);
const calendarMonths = [...new Set(workouts.map(({ activityDate }) => activityDate.slice(0, 7)))]
  .sort()
  .reverse()
  .map((monthKey) => {
    const [year, month] = monthKey.split("-").map(Number);
    const monthWorkouts = workouts.filter(({ activityDate }) =>
      activityDate.startsWith(`${monthKey}-`),
    );
    const workoutsByDay = new Map<number, typeof workouts>();
    for (const workout of monthWorkouts) {
      const day = Number(workout.activityDate.slice(-2));
      workoutsByDay.set(day, [...(workoutsByDay.get(day) ?? []), workout]);
    }
    const leadingDays = (new Date(Date.UTC(year, month - 1, 1)).getUTCDay() + 6) % 7;
    const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();

    return {
      key: monthKey,
      label: `${year} 年 ${month} 月`,
      activityCount: monthWorkouts.length,
      cells: [
        ...Array.from({ length: leadingDays }, () => null),
        ...Array.from({ length: daysInMonth }, (_, index) => ({
          day: index + 1,
          date: `${monthKey}-${String(index + 1).padStart(2, "0")}`,
          workouts: workoutsByDay.get(index + 1) ?? [],
        })),
      ],
    };
  });
---

<BaseLayout title="运动记录" description="Garmin 运动记录">
  <section class="page-intro extras-intro">
    <span class="eyebrow">MOVEMENT / 运动</span>
    <h1>运动记录</h1>
    <p>从旧博客迁移的 Garmin 运动快照。写作留下思考，运动留下身体经过时间的证据。</p>
  </section>

  <section class="workout-summary" aria-label="最近七天运动汇总">
    <div>
      <strong>{recentWorkouts.length}</strong>
      <span>最近 7 天 · 次活动</span>
    </div>
    <div><strong>{recentMinutes}</strong><span>最近 7 天 · 分钟</span></div>
    <div>
      <strong>{recentCalories.toLocaleString("zh-CN")}</strong>
      <span>最近 7 天 · 千卡</span>
    </div>
  </section>
  <div class="workout-view-toolbar">
    {latestDate && <p>统计截至 {latestDate}</p>}
    <div class="workout-view-switcher" role="tablist" aria-label="运动记录视图">
      <button
        type="button"
        role="tab"
        id="workout-tab-list"
        aria-controls="workout-panel-list"
        aria-selected="false"
        tabindex="-1"
        data-workout-view="list"
      >
        <span aria-hidden="true">☷</span>列表
      </button>
      <button
        type="button"
        role="tab"
        id="workout-tab-calendar"
        aria-controls="workout-panel-calendar"
        aria-selected="true"
        data-workout-view="calendar"
      >
        <span aria-hidden="true">▦</span>日历
      </button>
    </div>
  </div>

  <section
    id="workout-panel-list"
    class="workout-list"
    role="tabpanel"
    aria-labelledby="workout-tab-list"
    aria-label="运动记录列表"
    data-workout-panel="list"
    hidden
  >
    {workouts.map((workout) => {
      const kind = workoutKind(workout.name);
      const detailId = `workout-list-detail-${workout.externalId}`;
      const details = workoutDetails(workout);
      const trainingSections = Object.entries(workout.trainingDetails ?? {})
        .map(([section, value]) => ({
          title: trainingDetailSectionNames[section] ?? detailLabel(section),
          rows: flattenTrainingDetails(value),
        }))
        .filter(({ rows }) => rows.length > 0);
      return (
        <article
          class="workout-row"
          tabindex="0"
          aria-describedby={detailId}
        >
          <time datetime={workout.activityDate}>{formatDate(workout.activityDate)}</time>
          <i
            class:list={["workout-kind", `workout-kind--${kind}`]}
            aria-label={workoutKinds[kind].label}
          >
            {workoutKinds[kind].mark}
          </i>
          <h2>{workout.name}</h2>
          <div class="workout-row-metrics">
            <span><small>时长</small>{formatDuration(workout.durationSeconds)}</span>
            <span><small>热量</small>{workout.caloriesKcal} kcal</span>
          </div>
          <div
            id={detailId}
            class="workout-calendar-detail workout-row-detail"
            role="tooltip"
          >
            <strong>{workout.name}</strong>
            <div class="workout-calendar-detail-scroll" tabindex="0">
              <section>
                <h4>活动摘要</h4>
                <dl>
                  {details.map(([label, value]) => (
                    <div>
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              </section>
              {trainingSections.map(({ title, rows }) => (
                <section>
                  <h4>{title}</h4>
                  <dl>
                    {rows.map(([label, value]) => (
                      <div>
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                      </div>
                    ))}
                  </dl>
                </section>
              ))}
            </div>
          </div>
        </article>
      );
    })}
  </section>

  <section
    id="workout-panel-calendar"
    class="workout-calendar"
    role="tabpanel"
    aria-labelledby="workout-tab-calendar"
    aria-label="运动记录日历"
    data-workout-panel="calendar"
  >
    {calendarMonths.map((calendarMonth) => (
      <article class="workout-calendar-month">
        <header>
          <h2>{calendarMonth.label}</h2>
          <span>{calendarMonth.activityCount} 次活动</span>
        </header>
        <div class="workout-calendar-weekdays" aria-hidden="true">
          {["一", "二", "三", "四", "五", "六", "日"].map((weekday) => (
            <span>{weekday}</span>
          ))}
        </div>
        <div class="workout-calendar-grid">
          {calendarMonth.cells.map((cell) =>
            cell ? (
              <div
                class:list={[
                  "workout-calendar-day",
                  { "has-workout": cell.workouts.length > 0 },
                ]}
                data-calendar-date={cell.date}
                aria-label={`${cell.date}，${cell.workouts.length} 次活动`}
              >
                <span>{cell.day}</span>
                <div class="workout-calendar-marks">
                  {cell.workouts.map((workout) => {
                    const kind = workoutKind(workout.name);
                    const detailId = `workout-detail-${workout.externalId}`;
                    const details = workoutDetails(workout);
                    const trainingSections = Object.entries(
                      workout.trainingDetails ?? {},
                    )
                      .map(([section, value]) => ({
                        title: trainingDetailSectionNames[section] ?? detailLabel(section),
                        rows: flattenTrainingDetails(value),
                      }))
                      .filter(({ rows }) => rows.length > 0);
                    return (
                      <span class="workout-calendar-marker">
                        <button
                          type="button"
                          class:list={["workout-kind", `workout-kind--${kind}`]}
                          aria-label={`${workout.name}，${workout.activityDate}`}
                          aria-describedby={detailId}
                        >
                          <span aria-hidden="true">{workoutKinds[kind].mark}</span>
                        </button>
                        <div
                          id={detailId}
                          class="workout-calendar-detail"
                          role="tooltip"
                        >
                          <strong>{workout.name}</strong>
                          <div class="workout-calendar-detail-scroll" tabindex="0">
                            <section>
                              <h4>活动摘要</h4>
                              <dl>
                                {details.map(([label, value]) => (
                                  <div>
                                    <dt>{label}</dt>
                                    <dd>{value}</dd>
                                  </div>
                                ))}
                              </dl>
                            </section>
                            {trainingSections.map(({ title, rows }) => (
                              <section>
                                <h4>{title}</h4>
                                <dl>
                                  {rows.map(([label, value]) => (
                                    <div>
                                      <dt>{label}</dt>
                                      <dd>{value}</dd>
                                    </div>
                                  ))}
                                </dl>
                              </section>
                            ))}
                          </div>
                        </div>
                      </span>
                    );
                  })}
                </div>
              </div>
            ) : (
              <div class="workout-calendar-day is-empty" aria-hidden="true"></div>
            ),
          )}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<script>
  const viewButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-workout-view]",
  );
  const viewPanels = document.querySelectorAll<HTMLElement>(
    "[data-workout-panel]",
  );

  function setWorkoutView(view: "list" | "calendar") {
    viewButtons.forEach((button) => {
      const selected = button.dataset.workoutView === view;
      button.setAttribute("aria-selected", String(selected));
      button.tabIndex = selected ? 0 : -1;
    });
    viewPanels.forEach((panel) => {
      panel.hidden = panel.dataset.workoutPanel !== view;
    });
  }

  viewButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setWorkoutView(
        button.dataset.workoutView === "calendar" ? "calendar" : "list",
      );
    });
    button.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      const nextView =
        button.dataset.workoutView === "calendar" ? "list" : "calendar";
      setWorkoutView(nextView);
      document
        .querySelector<HTMLButtonElement>(`[data-workout-view="${nextView}"]`)
        ?.focus();
    });
  });

  const todayInShanghai = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(new Date());
  document
    .querySelector(`[data-calendar-date="${todayInShanghai}"]`)
    ?.classList.add("is-today");
</script>
