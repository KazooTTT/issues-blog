---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadFitnessSnapshot } from "@/fitness/load";
import { summarise } from "@/fitness/series";
import { chartGeometry } from "@/fitness/chart";
import { sitePath } from "@/utils/presentation";

const snapshot = await loadFitnessSnapshot();
const summary = snapshot ? summarise(snapshot.series) : null;

const PERIODS = [30, 90, 180, 365] as const;
const requested = Number(Astro.url.searchParams.get("days") ?? 90);
const windowDays = (PERIODS as readonly number[]).includes(requested) ? requested : 90;

const points = snapshot ? snapshot.series.slice(-windowDays) : [];
const geometry = chartGeometry(points);
const hasAnyTrainingLoad = snapshot
  ? snapshot.series.some((point) => point.load > 0)
  : false;

// 时间范围切换靠前端切片，服务端只把最近一年序列交给浏览器，避免每次点击都整页刷新。
// 没有 JavaScript 时，下面的链接仍然按 ?days= 正常跳转。
const history = snapshot ? snapshot.series.slice(-365) : [];
const chartPayload = history.map((point) => ({
  d: point.date,
  l: point.load,
  c: point.ctl,
  a: point.atl,
  t: point.tsb,
}));

const shortDate = (value: string) => value.slice(5).replace("-", "/");
---

<BaseLayout
  title="体能"
  description="长期体能、短期疲劳与当下状态的每日推算，数据来自本机的 Garmin 同步。"
>
  <section class="page-intro fitness-intro">
    <span class="eyebrow">TRAINING LOAD</span>
    <h1>体能</h1>
    <p>
      每次运动都会留下一点负荷。把它按两条不同速度的曲线摊开，就能看出身体攒下了多少余量、最近又压上了多少疲劳。
    </p>
  </section>

  {
    summary && snapshot && hasAnyTrainingLoad ? (
      <>
        <section class="workout-summary fitness-summary" aria-label="当前训练状态">
          <div>
            <strong>{summary.ctl}</strong>
            <span>长期体能 · 42 天</span>
          </div>
          <div>
            <strong>{summary.atl}</strong>
            <span>短期疲劳 · 7 天</span>
          </div>
          <div>
            <strong>{summary.tsb > 0 ? `+${summary.tsb}` : summary.tsb}</strong>
            <span>当下状态 · 体能减疲劳</span>
          </div>
        </section>

        <section class="fitness-state" aria-label="状态解读">
          <div class="fitness-state-head">
            <span class="fitness-badge">{summary.label}</span>
            <span class="fitness-ratio">
              疲劳 / 体能 {summary.ratio.toFixed(2)} · 体能较上周
              {summary.ctlDelta >= 0 ? " +" : " "}
              {summary.ctlDelta}
            </span>
          </div>
          <p>{summary.advice}</p>
          <p class="fitness-week">
            最近七天负荷 <strong>{summary.weekLoad}</strong>，前七天
            <strong>{summary.prevWeekLoad}</strong>，{summary.weekLoad - summary.prevWeekLoad >= 0
              ? "增加"
              : "减少"}
            <strong>{Math.abs(Math.round((summary.weekLoad - summary.prevWeekLoad) * 10) / 10)}</strong>。
          </p>
        </section>

        <section class="fitness-chart-block">
          <div class="section-heading">
            <h2>负荷走势</h2>
            <span data-period-label>{windowDays} 天</span>
          </div>

          <nav class="fitness-periods" aria-label="时间范围">
            {PERIODS.map((period) => (
              <a
                class:list={{ "is-active": period === windowDays }}
                href={`${sitePath("/fitness/")}?days=${period}`}
                data-period={period}
                aria-current={period === windowDays ? "true" : undefined}
              >
                {period} 天
              </a>
            ))}
          </nav>

          <figure class="fitness-chart" data-chart-visual hidden={!geometry.hasData}>
            <svg
              id="fitness-chart-svg"
              viewBox={`0 0 760 260`}
              role="img"
              aria-label={`${geometry.firstDate} 至 ${geometry.lastDate} 的体能、疲劳与状态走势`}
              preserveAspectRatio="none"
            >
              <line
                class="fitness-zero"
                x1="8"
                x2="752"
                y1={geometry.zeroY}
                y2={geometry.zeroY}
              />
              <path
                class="fitness-line fitness-line-ctl"
                data-line="ctl"
                d={geometry.ctlPath}
              />
              <path
                class="fitness-line fitness-line-atl"
                data-line="atl"
                d={geometry.atlPath}
              />
              <path
                class="fitness-line fitness-line-tsb"
                data-line="tsb"
                d={geometry.tsbPath}
              />
            </svg>
            <figcaption>
              <span class="fitness-axis" data-axis="start">{geometry.hasData ? shortDate(geometry.firstDate) : ""}</span>
              <span class="fitness-axis" data-axis="end">{geometry.hasData ? shortDate(geometry.lastDate) : ""}</span>
            </figcaption>
          </figure>

          <p class="fitness-chart-empty" data-chart-empty hidden={geometry.hasData}>
            这段时间还没有运动记录，所以没有曲线可画。
          </p>

          <ul class="fitness-legend" data-chart-visual hidden={!geometry.hasData}>
            <li><i class="swatch swatch-ctl"></i>长期体能</li>
            <li><i class="swatch swatch-atl"></i>短期疲劳</li>
            <li><i class="swatch swatch-tsb"></i>状态</li>
          </ul>
        </section>

        <details class="fitness-explain">
          <summary>这几个数字是什么意思、怎么算的</summary>

          <div class="fitness-explain-body">
            <h3>三个指标</h3>
            <dl>
              <div>
                <dt>长期体能</dt>
                <dd>
                  过去大约六周里你持续承受的训练量，相当于身体的「底子」。练得越多涨得越慢，停练也会慢慢掉。
                </dd>
              </div>
              <div>
                <dt>短期疲劳</dt>
                <dd>
                  最近一周的训练量，反应快、起伏大。一次长距离或强度课会把它顶上去，休息几天就落回来。
                </dd>
              </div>
              <div>
                <dt>当下状态</dt>
                <dd>
                  长期体能减短期疲劳。正数是余量，负数是欠账——负得越多，说明最近的负荷越超出你已经攒下的底子。
                </dd>
              </div>
              <div>
                <dt>负荷</dt>
                <dd>
                  每次运动从 Garmin 带回来的训练负荷值。同一天有多次运动就相加，休息日记为 0。
                </dd>
              </div>
            </dl>

            <h3>算法</h3>
            <p>两条曲线都是指数移动平均，只是时间常数不同：</p>
            <ul>
              <li>长期体能：42 天，每天 <code>体能 += (当天负荷 − 体能) / 42</code></li>
              <li>短期疲劳：7 天，每天 <code>疲劳 += (当天负荷 − 疲劳) / 7</code></li>
              <li>当下状态：<code>体能 − 疲劳</code></li>
            </ul>
            <p>
              也就是说当天负荷只按比例渗进曲线，不会整体重算历史；时间常数越大，曲线越迟钝。
              每天先记录「吸收负荷之前」的数值，再把当天负荷并入，所以图上某一天的点，是那天训练之前的状态。
              从两年前开始逐日推演，所有数值保留一位小数。
            </p>

            <h3>状态判定</h3>
            <dl class="fitness-thresholds">
              <div><dt>状态 ≥ 20</dt><dd>余量充足</dd></div>
              <div><dt>5 ~ 20</dt><dd>良好</dd></div>
              <div><dt>-10 ~ 5</dt><dd>正常</dd></div>
              <div><dt>-30 ~ -10</dt><dd>偏疲劳</dd></div>
              <div><dt>&lt; -30</dt><dd>疲劳较高</dd></div>
            </dl>
            <p class="fitness-explain-foot">
              数据由本机同步写入 D1，页面只读。模型口径沿用原看板的 Python 实现，数值与那边一致。
            </p>
          </div>
        </details>

        <script
          type="application/json"
          id="fitness-series-data"
          set:html={JSON.stringify(chartPayload)}
        />
      </>
    ) : (
      <section class="fitness-empty">
        {hasAnyTrainingLoad ? (
          <>
            <h2>数据暂不可用</h2>
            <p>这一刻没读到 D1 里的运动记录。稍后刷新，或先去看一眼运动记录是否正常。</p>
          </>
        ) : (
          <>
            <h2>还没有运动记录</h2>
            <p>D1 里暂时没有训练负荷，等本机同步写入之后，这里会出现曲线。</p>
          </>
        )}
        <a href={sitePath("/workouts/")}>去运动记录 →</a>
      </section>
    )
  }
</BaseLayout>

<script>
  import { chartGeometry } from "../fitness/chart";
  import type { SeriesPoint } from "../fitness/series";

  interface CompactPoint {
    d: string;
    l: number;
    c: number;
    a: number;
    t: number;
  }

  const dataElement = document.getElementById("fitness-series-data");
  const svg = document.getElementById("fitness-chart-svg");
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("a[data-period]"),
  );

  if (dataElement && svg && links.length) {
    const series: SeriesPoint[] = (
      JSON.parse(dataElement.textContent ?? "[]") as CompactPoint[]
    ).map((point) => ({
      date: point.d,
      load: point.l,
      ctl: point.c,
      atl: point.a,
      tsb: point.t,
    }));

    const visuals = Array.from(
      document.querySelectorAll<HTMLElement>("[data-chart-visual]"),
    );
    const emptyNote = document.querySelector<HTMLElement>("[data-chart-empty]");

    const lineOf = (name: string) =>
      svg.querySelector<SVGPathElement>(`[data-line="${name}"]`);
    const ctlLine = lineOf("ctl");
    const atlLine = lineOf("atl");
    const tsbLine = lineOf("tsb");
    const zeroLine = svg.querySelector<SVGLineElement>("line");
    const axisStart = document.querySelector<HTMLElement>('[data-axis="start"]');
    const axisEnd = document.querySelector<HTMLElement>('[data-axis="end"]');
    const periodLabel = document.querySelector<HTMLElement>("[data-period-label]");
    const short = (value: string) => value.slice(5).replace("-", "/");

    const render = (days: number, updateUrl: boolean) => {
      const geometry = chartGeometry(series.slice(-days));
      ctlLine?.setAttribute("d", geometry.ctlPath);
      atlLine?.setAttribute("d", geometry.atlPath);
      tsbLine?.setAttribute("d", geometry.tsbPath);
      zeroLine?.setAttribute("y1", String(geometry.zeroY));
      zeroLine?.setAttribute("y2", String(geometry.zeroY));
      svg.setAttribute(
        "aria-label",
        geometry.hasData
          ? `${geometry.firstDate} 至 ${geometry.lastDate} 的体能、疲劳与状态走势`
          : "这段时间还没有运动记录",
      );
      if (axisStart) axisStart.textContent = geometry.hasData ? short(geometry.firstDate) : "";
      if (axisEnd) axisEnd.textContent = geometry.hasData ? short(geometry.lastDate) : "";
      if (periodLabel) periodLabel.textContent = `${days} 天`;

      for (const visual of visuals) visual.hidden = !geometry.hasData;
      if (emptyNote) emptyNote.hidden = geometry.hasData;

      for (const link of links) {
        const active = Number(link.dataset.period) === days;
        link.classList.toggle("is-active", active);
        if (active) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }

      if (updateUrl) {
        history.replaceState(history.state, "", `?days=${days}`);
      }
    };

    for (const link of links) {
      link.addEventListener("click", (event) => {
        // 让「新标签页打开」这类操作保持原始的链接行为。
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        const days = Number(link.dataset.period);
        if (!days) return;
        event.preventDefault();
        render(days, true);
      });
    }
  }
</script>

<style>
  .fitness-summary strong {
    font-variant-numeric: tabular-nums;
  }

  .fitness-state {
    margin: 34px 0 56px;
    padding: 26px 28px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--card);
    box-shadow: var(--shadow);
  }

  .fitness-state-head {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .fitness-badge {
    font: 600 26px/1.2 var(--serif);
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .fitness-ratio {
    color: var(--muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .fitness-state p {
    margin: 0;
    line-height: 1.85;
  }

  .fitness-week {
    margin-top: 12px !important;
    color: var(--muted);
    font-size: 13px;
  }

  .fitness-week strong {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .fitness-chart-block {
    --fitness-ctl: #257773;
    --fitness-atl: #bd5631;
    --fitness-tsb: #526883;
    margin-bottom: 46px;
  }

  :global([data-theme="dark"]) .fitness-chart-block {
    --fitness-ctl: #69c3b8;
    --fitness-atl: #f18b65;
    --fitness-tsb: #a8bcd4;
  }

  .fitness-periods {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: -18px 0 22px;
  }

  .fitness-periods a {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 12px;
    text-decoration: none;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  .fitness-periods a:hover,
  .fitness-periods a.is-active {
    border-color: var(--accent);
    color: var(--accent);
  }

  .fitness-chart {
    margin: 0;
  }

  .fitness-chart svg {
    display: block;
    width: 100%;
    height: 260px;
    overflow: visible;
  }

  .fitness-chart figcaption {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
  }

  .fitness-axis {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .fitness-zero {
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    vector-effect: non-scaling-stroke;
  }

  .fitness-line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    transition: d 0.28s ease;
  }

  .fitness-line-ctl {
    stroke: var(--fitness-ctl);
    stroke-width: 3;
  }

  .fitness-line-atl {
    stroke: var(--fitness-atl);
    stroke-width: 2.5;
  }

  .fitness-line-tsb {
    stroke: var(--fitness-tsb);
    stroke-width: 2;
    stroke-dasharray: 6 5;
  }

  .fitness-chart-empty {
    margin: 0;
    padding: 34px 0;
    color: var(--muted);
    font-size: 13px;
  }

  .fitness-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 12px;
  }

  .fitness-legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .swatch {
    width: 24px;
    height: 0;
    border-top: 2px solid var(--fitness-tsb);
  }

  .swatch-ctl {
    border-color: var(--fitness-ctl);
    border-width: 3px;
  }

  .swatch-atl {
    border-color: var(--fitness-atl);
    border-width: 3px;
  }

  .swatch-tsb {
    border-style: dashed;
  }

  .fitness-explain {
    margin: 0 0 60px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
  }

  .fitness-explain summary {
    padding: 16px 20px;
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: color 0.16s ease;
  }

  .fitness-explain summary::-webkit-details-marker {
    display: none;
  }

  .fitness-explain summary::before {
    content: "+";
    width: 16px;
    color: var(--accent);
    font-size: 15px;
    line-height: 1;
  }

  .fitness-explain[open] summary::before {
    content: "−";
  }

  .fitness-explain summary:hover {
    color: var(--ink);
  }

  .fitness-explain-body {
    padding: 0 20px 20px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.85;
  }

  .fitness-explain h3 {
    margin: 20px 0 10px;
    font: 600 13px/1.4 var(--sans);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fitness-explain dl {
    margin: 0;
  }

  .fitness-explain dl > div {
    display: grid;
    grid-template-columns: minmax(88px, 0.22fr) minmax(0, 1fr);
    gap: 14px;
    padding: 9px 0;
    border-top: 1px solid var(--line);
  }

  .fitness-explain dl > div:first-child {
    border-top: 0;
  }

  .fitness-explain dt {
    color: var(--ink);
    font-weight: 600;
    font-size: 13px;
  }

  .fitness-explain dd {
    margin: 0;
    color: var(--muted);
  }

  .fitness-explain p {
    margin: 0 0 10px;
    color: var(--muted);
  }

  .fitness-explain ul {
    margin: 0 0 10px;
    padding-left: 18px;
    color: var(--muted);
  }

  .fitness-explain li {
    margin: 4px 0;
  }

  .fitness-explain code {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--line);
    color: var(--ink);
    font-size: 0.9em;
  }

  .fitness-thresholds dd {
    font-variant-numeric: tabular-nums;
  }

  .fitness-explain-foot {
    margin-top: 18px !important;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 12px;
  }

  @media (max-width: 720px) {
    .fitness-explain dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }

  .fitness-empty {
    margin: 40px 0 80px;
    padding: 30px 28px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--card);
  }

  .fitness-empty h2 {
    margin: 0 0 10px;
    font: 600 24px/1.3 var(--serif);
  }

  .fitness-empty p {
    margin: 0 0 14px;
    color: var(--muted);
  }

  .fitness-empty a {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .fitness-state {
      padding: 20px 18px;
    }

    .fitness-chart svg {
      height: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fitness-line {
      transition: none;
    }
  }
</style>
