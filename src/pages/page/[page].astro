---
import PostList from "@/components/PostList.astro";
import { siteConfig } from "@/config";
import { getSiteContent } from "@/data/site-content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { regularPosts, sitePath } from "@/utils/presentation";

export async function getStaticPaths() {
  const { posts } = await getSiteContent();
  const regular = regularPosts(posts);
  const pageCount = Math.ceil(regular.length / siteConfig.postsPerPage);
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
    const page = index + 2;
    const start = (page - 1) * siteConfig.postsPerPage;
    return {
      params: { page: String(page) },
      props: {
        posts: regular.slice(start, start + siteConfig.postsPerPage),
        page,
        pageCount,
      },
    };
  });
}

const { posts, page, pageCount } = Astro.props;
---

<BaseLayout title={`文章 · 第 ${page} 页`}>
  <section class="page-intro">
    <span class="eyebrow">PAGE {String(page).padStart(2, "0")}</span>
    <h1>文章列表</h1>
  </section>
  <PostList posts={posts} />
  <nav class="pagination" aria-label="分页">
    <a href={sitePath(page === 2 ? "/" : `/page/${page - 1}/`)}>← 上一页</a>
    <span>{page} / {pageCount}</span>
    {page < pageCount
      ? <a href={sitePath(`/page/${page + 1}/`)}>下一页 →</a>
      : <span class="pagination-disabled">下一页 →</span>}
  </nav>
</BaseLayout>
