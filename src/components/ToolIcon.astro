---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true">
  {name === "code" && (
    <>
      <path d="m8 9-3 3 3 3"></path>
      <path d="m16 9 3 3-3 3"></path>
      <path d="m14 5-4 14"></path>
    </>
  )}
  {name === "design" && (
    <>
      <circle cx="12" cy="12" r="8"></circle>
      <circle cx="9" cy="9" r="1"></circle>
      <circle cx="15" cy="9" r="1"></circle>
      <circle cx="9" cy="15" r="1"></circle>
      <path d="M15 15h.01"></path>
    </>
  )}
  {name === "record" && (
    <>
      <rect x="3" y="5" width="14" height="14" rx="2"></rect>
      <path d="m17 10 4-2v8l-4-2"></path>
      <circle cx="10" cy="12" r="2.5"></circle>
    </>
  )}
  {name === "browser" && (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 9h18M8 3.8c2.5 2.8 2.5 13.6 0 16.4M16 3.8c-2.5 2.8-2.5 13.6 0 16.4"></path>
    </>
  )}
  {name === "note" && (
    <>
      <path d="M6 3h9l3 3v15H6z"></path>
      <path d="M14 3v4h4M9 11h6M9 15h6"></path>
    </>
  )}
  {name === "flow" && (
    <>
      <circle cx="6" cy="6" r="2"></circle>
      <circle cx="18" cy="12" r="2"></circle>
      <circle cx="6" cy="18" r="2"></circle>
      <path d="M8 6h3a3 3 0 0 1 3 3v0a3 3 0 0 0 3 3M8 18h3a3 3 0 0 0 3-3v0"></path>
    </>
  )}
  {name === "ai" && (
    <>
      <path d="M12 3v3M12 18v3M3 12h3M18 12h3"></path>
      <rect x="6" y="6" width="12" height="12" rx="3"></rect>
      <circle cx="10" cy="11" r="1"></circle>
      <circle cx="14" cy="11" r="1"></circle>
      <path d="M9.5 15h5"></path>
    </>
  )}
  {name === "music" && (
    <>
      <path d="M9 18V6l10-2v12"></path>
      <circle cx="6" cy="18" r="3"></circle>
      <circle cx="16" cy="16" r="3"></circle>
    </>
  )}
  {name === "book" && (
    <>
      <path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22z"></path>
      <path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22z"></path>
    </>
  )}
  {name === "health" && (
    <>
      <path d="M3 12h4l2-5 4 10 2-5h6"></path>
      <path d="M19.5 5.5a4.2 4.2 0 0 0-6 0L12 7l-1.5-1.5a4.2 4.2 0 0 0-6 6L12 19l7.5-7.5a4.2 4.2 0 0 0 0-6Z"></path>
    </>
  )}
  {name === "computer" && (
    <>
      <rect x="3" y="4" width="18" height="13" rx="2"></rect>
      <path d="M8 21h8M12 17v4"></path>
    </>
  )}
  {name === "mobile" && (
    <>
      <rect x="7" y="2" width="10" height="20" rx="2"></rect>
      <path d="M11 18h2"></path>
    </>
  )}
  {name === "wearable" && (
    <>
      <rect x="7" y="6" width="10" height="12" rx="3"></rect>
      <path d="m9 6 1-4h4l1 4M9 18l1 4h4l1-4M12 9v3l2 1"></path>
    </>
  )}
  {name === "headphones" && (
    <>
      <path d="M4 14v-2a8 8 0 0 1 16 0v2"></path>
      <path d="M4 14a2 2 0 0 1 2-2h1v7H6a2 2 0 0 1-2-2zM20 14a2 2 0 0 0-2-2h-1v7h1a2 2 0 0 0 2-2z"></path>
    </>
  )}
  {name === "camera" && (
    <>
      <path d="M4 7h4l1.5-2h5L16 7h4a2 2 0 0 1 2 2v9H2V9a2 2 0 0 1 2-2Z"></path>
      <circle cx="12" cy="13" r="4"></circle>
    </>
  )}
  {name === "lens" && (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <circle cx="12" cy="12" r="5"></circle>
      <path d="m9 8 6 8M15 8l-6 8"></path>
    </>
  )}
  {![
    "code", "design", "record", "browser", "note", "flow", "ai", "music",
    "book", "health", "computer", "mobile", "wearable", "headphones",
    "camera", "lens",
  ].includes(name) && (
    <>
      <path d="m14.7 6.3 3 3M5 19l4.2-1 9.5-9.5a2.1 2.1 0 0 0-3-3L6.2 15z"></path>
    </>
  )}
</svg>
