---
interface Props {
  label: string;
  active?: boolean;
}
const { label, active = false } = Astro.props;
---

<details class="header-dropdown" data-header-dropdown>
  <summary class:list={{ "nav-link-active": active }}>{label}</summary>
  <div class="header-dropdown-panel"><slot /></div>
</details>

<style>
  .header-dropdown { position: relative; }
  summary { display: flex; align-items: center; min-height: 44px; gap: 8px; padding: 10px 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ""; width: 6px; height: 6px; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: rotate(45deg); opacity: .65; }
  details[open] summary::after { transform: rotate(225deg); }
  summary.nav-link-active { color: var(--accent-dark); }
  .header-dropdown-panel {
    position: absolute; z-index: 30; top: 100%; left: 0;
    display: grid; min-width: 155px; padding: 8px;
    border: 1px solid var(--line); border-radius: 10px;
    background: var(--card); box-shadow: var(--shadow);
  }
  .header-dropdown-panel :global(a) { padding: 10px 12px; border-radius: 5px; font-size: 13px; white-space: nowrap; }
  .header-dropdown-panel :global(a:hover),
  .header-dropdown-panel :global(a:focus-visible),
  .header-dropdown-panel :global(a.nav-link-active) { color: var(--accent-dark); background: var(--paper-deep); }
</style>
