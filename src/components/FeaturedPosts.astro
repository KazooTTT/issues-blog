---
import type { Post } from "@/domain/types";
import { deriveExcerpt } from "@/rendering/content";
import { formatDate, sitePath } from "@/utils/presentation";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section class="featured-list" aria-label="精选文章">
  {posts.map((post, index) => (
    <article class="featured-item">
      <span class="featured-index">{String(index + 1).padStart(2, "0")}</span>
      <div class="featured-content">
        <span class="eyebrow">精选</span>
        <h2><a href={sitePath(post.permalink)}>{post.title}</a></h2>
        <p>{deriveExcerpt(post.body)}</p>
      </div>
      <footer class="featured-meta">
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
        <span>{post.tags.join(" / ")}</span>
      </footer>
    </article>
  ))}
</section>
