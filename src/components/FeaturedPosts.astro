---
import type { Post } from "@/domain/types";
import PageStatistics from "@/components/PageStatistics.astro";
import WritingSourceBadge from "@/components/WritingSourceBadge.astro";
import { topicTags, writingSource } from "@/utils/writing-source";
import { deriveExcerpt } from "@/rendering/content";
import { formatDate, sitePath } from "@/utils/presentation";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section class="featured-list" aria-label="精选文章" data-writing-list>
  {posts.map((post, index) => (
    <article class="featured-item" data-writing-source={writingSource(post.tags) ?? "unknown"}>
      <span class="featured-index">{String(index + 1).padStart(2, "0")}</span>
      <div class="featured-content">
        <span class="eyebrow">精选</span>
        <h2><a href={sitePath(post.permalink)}>{post.title}<WritingSourceBadge tags={post.tags} /></a></h2>
        <p>{deriveExcerpt(post.body)}</p>
      </div>
      <footer class="featured-meta">
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
        <div class="featured-tags">
          {topicTags(post.tags).map((tag) => (
            <a class="tag" href={sitePath(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
          ))}
        </div>
      </footer>
      <PageStatistics path={post.permalink} compact />
    </article>
  ))}
</section>
<p class="writing-filter-empty" role="status" hidden>暂无以人工写作为主的精选文章。</p>
